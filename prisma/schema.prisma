// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  CARD_EXPENSE
}

enum TransactionStatus {
  PAID
  PENDING
}

model Account {
  id          String      @id @default(cuid())
  name        String
  type        AccountType
  institution String?
  balance     Decimal     @default(0) @db.Decimal(12, 2)
  color       String      @default("#2E7D6B")
  createdAt   DateTime    @default(now())

  transactions Transaction[] @relation("AccountTransactions")
  transfersIn  Transaction[] @relation("TransferDestination")
  creditCards  CreditCard[]
}

model CreditCard {
  id               String        @id @default(cuid())
  name             String
  limit            Decimal       @db.Decimal(12, 2)
  closingDay       Int
  dueDay           Int
  color            String        @default("#6D4AFF")
  paymentAccountId String?
  paymentAccount   Account?      @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  createdAt        DateTime      @default(now())
}

model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  type      CategoryType
  icon      String       @default("tag")
  color     String       @default("#6B7280")
  createdAt DateTime     @default(now())

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String            @id @default(cuid())
  description String
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  type        TransactionType
  status      TransactionStatus @default(PAID)

  accountId String?
  account   Account? @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)

  toAccountId String?
  toAccount   Account? @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  isRecurring       Boolean @default(false)
  installmentNumber Int?
  installmentTotal  Int?

  ignored       Boolean  @default(false)
  tags          String[] @default([])
  note          String?
  attachmentUrl String?

  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
}

model Budget {
  id            String   @id @default(cuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  plannedAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@unique([categoryId, month, year])
}
