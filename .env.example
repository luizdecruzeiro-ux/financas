# Connection string do seu projeto Supabase (Settings > Database > Connection string > URI)
# Use a "Connection pooling" string para a app e a "Direct connection" para migrations, se necessário.
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# Usados só para o anexo de arquivo em transações (Supabase Storage).
# NEXT_PUBLIC_SUPABASE_URL: Settings > API > Project URL
# SUPABASE_SERVICE_ROLE_KEY: Settings > API Keys > service_role (secreta, nunca expor no client)
# Requer um bucket público chamado "attachments" criado em Storage.
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJETO].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SUA-SERVICE-ROLE-KEY]"
